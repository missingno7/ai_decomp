{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_decomp proposed authored trajectory v1",
  "type": "object",
  "required": [
    "id",
    "project",
    "target",
    "epistemic_class",
    "steps",
    "outcome",
    "sources",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_class": {
      "enum": [
        "PROJECT FACT",
        "CROSS-PROJECT PATTERN",
        "WORKING HYPOTHESIS",
        "GENERIC METHOD"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation",
          "interpretation",
          "sources"
        ],
        "properties": {
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array"
          },
          "experiment_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "limitations": {
      "type": "array"
    },
    "experiment_ids": {
      "type": "array"
    },
    "mechanisms": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
